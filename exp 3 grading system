<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Advanced Grading System</title>
    <style>
        :root {
            --primary: #4f46e5;
            --primary-hover: #4338ca;
            --background: #f8fafc;
            --card-bg: #ffffff;
            --text-main: #1e293b;
            --text-muted: #64748b;
            --error: #ef4444;
            --success: #22c55e;
            --success-bg: #f0fdf4;
            --fail: #ef4444;
            --fail-bg: #fef2f2;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
        }

        body {
            background-color: var(--background);
            color: var(--text-main);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
        }

        .card {
            background: var(--card-bg);
            width: 100%;
            max-width: 450px;
            padding: 40px;
            border-radius: 24px;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05), 0 8px 10px -6px rgba(0, 0, 0, 0.05);
            transition: transform 0.3s ease;
        }

        h2 {
            font-size: 28px;
            font-weight: 700;
            margin-bottom: 8px;
            color: #0f172a;
        }

        p.subtitle {
            color: var(--text-muted);
            font-size: 15px;
            margin-bottom: 32px;
        }

        .form-group {
            margin-bottom: 24px;
            position: relative;
        }

        label {
            display: block;
            margin-bottom: 8px;
            font-weight: 600;
            font-size: 14px;
            color: #334155;
        }

        .input-wrapper {
            position: relative;
        }

        input[type="number"] {
            width: 100%;
            padding: 14px 16px;
            font-size: 16px;
            border: 2px solid #e2e8f0;
            border-radius: 12px;
            outline: none;
            transition: all 0.2s ease;
            background: #fbfcfe;
        }

        input[type="number"]:focus {
            border-color: var(--primary);
            background: #fff;
            box-shadow: 0 0 0 4px rgba(79, 70, 229, 0.1);
        }

        /* Verwijdert pijltjes in input box */
        input::-webkit-outer-spin-button,
        input::-webkit-inner-spin-button {
            -webkit-appearance: none;
            margin: 0;
        }

        .error-message {
            color: var(--error);
            font-size: 13px;
            margin-top: 6px;
            font-weight: 500;
            display: none;
            animation: fadeIn 0.2s ease;
        }

        button {
            width: 100%;
            padding: 14px;
            background-color: var(--primary);
            color: white;
            border: none;
            border-radius: 12px;
            cursor: pointer;
            font-size: 16px;
            font-weight: 600;
            transition: all 0.2s ease;
            box-shadow: 0 4px 6px -1px rgba(79, 70, 229, 0.2);
        }

        button:hover {
            background-color: var(--primary-hover);
            transform: translateY(-1px);
        }

        button:active {
            transform: translateY(1px);
        }

        .result-card {
            margin-top: 32px;
            padding: 20px;
            border-radius: 16px;
            display: none;
            animation: slideUp 0.4s cubic-bezier(0.16, 1, 0.3, 1);
            text-align: center;
        }

        .result-card.pass {
            background-color: var(--success-bg);
            border: 1px solid rgba(34, 197, 94, 0.2);
        }

        .result-card.fail {
            background-color: var(--fail-bg);
            border: 1px solid rgba(239, 68, 68, 0.2);
        }

        .result-score {
            font-size: 14px;
            text-transform: uppercase;
            letter-spacing: 1px;
            font-weight: 700;
            color: var(--text-muted);
            margin-bottom: 4px;
        }

        .result-grade {
            font-size: 32px;
            font-weight: 800;
            margin-bottom: 4px;
        }

        .pass .result-grade { color: var(--success); }
        .fail .result-grade { color: var(--fail); }

        .result-desc {
            font-size: 15px;
            font-weight: 500;
        }
        .pass .result-desc { color: #166534; }
        .fail .result-desc { color: #991b1b; }

        @keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }

        @keyframes slideUp {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }
    </style>
</head>
<body>

<div class="card">
    <h2>Grading System</h2>
    <p class="subtitle">Enter your score to calculate your final grade.</p>
    
    <form id="gradingForm" novalidate>
        <div class="form-group">
            <label for="marks">Your Marks</label>
            <div class="input-wrapper">
                <input type="number" id="marks" placeholder="Enter score (0 - 100)" min="0" max="100">
            </div>
            <div id="errorBox" class="error-message">Please enter a valid percentage between 0 and 100.</div>
        </div>
        <button type="submit">Check Result</button>
    </form>

    <div id="resultBox" class="result-card">
        <div class="result-score" id="resScore">Your Score: 0%</div>
        <div class="result-grade" id="resGrade">A+</div>
        <div class="result-desc" id="resDesc">Excellent Performance</div>
    </div>
</div>

<script>
    document.getElementById('gradingForm').addEventListener('submit', function(e) {
        e.preventDefault();

        const inputVal = document.getElementById('marks').value;
        const errorBox = document.getElementById('errorBox');
        const resultBox = document.getElementById('resultBox');
        
        const resScore = document.getElementById('resScore');
        const resGrade = document.getElementById('resGrade');
        const resDesc = document.getElementById('resDesc');

        // Formuliervalidatie
        if (inputVal === "" || isNaN(inputVal) || inputVal < 0 || inputVal > 100) {
            errorBox.style.display = 'block';
            resultBox.style.display = 'none';
            return;
        }

        errorBox.style.display = 'none';
        const score = parseFloat(inputVal);
        
        let grade = "";
        let description = "";
        let isPass = true;

        // Controlestructuur (If-Else)
        if (score >= 90) {
            grade = "A+";
            description = "Excellent Performance!";
        } else if (score >= 80) {
            grade = "A";
            description = "Very Good Job!";
        } else if (score >= 70) {
            grade = "B";
            description = "Good Effort!";
        } else if (score >= 60) {
            grade = "C";
            description = "Satisfactory Result.";
        } else if (score >= 50) {
            grade = "D";
            description = "You Passed.";
        } else {
            grade = "F";
            description = "An upgrade is needed.";
            isPass = false;
        }

        // UI Updaten
        resScore.textContent = `Your Score: ${score}%`;
        resGrade.textContent = grade;
        resDesc.textContent = description;

        // CSS Classes wisselen voor animatie en kleur
        resultBox.className = isPass ? "result-card pass" : "result-card fail";
        resultBox.style.display = 'block';
    });
</script>

</body>
</html>
